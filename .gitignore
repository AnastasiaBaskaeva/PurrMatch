# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# IDE and local build configuration
.idea/
*.iml
local.properties
.gradle/
**/build/
.DS_Store

# Gradle Wrapper must be tracked despite the archive rule above
!gradle-wrapper.jar

# Local environment configuration
.env
.env.*
!.env.example
